{
  "exclude": [
    "models/time/instances/",
    "compiler/",
    "math/",
    "lower/",
    "models/core/",
    "models/time/TimeCombinators.v",
    "models/time/TimeCostModel.v",
    "models/time/TimeDatatypes.v",
    "models/time/TimeFix.v",
    "models/time/TimeLists.v",
    "models/counting/counting_arith/TimeArith.v",
    "models/time/examples/Tutorial.v",
    "models/time/examples/Limitations.v",
    "models/time/examples/UnguardedFix.v"
  ],
  "renames": [
    [
      "^compiler/Combinators\\.v$",
      "math/Combinators.v"
    ],
    [
      "^model/([^/]+\\.v)$",
      "models/core/\\1"
    ],
    [
      "^time/TimeArith\\.v$",
      "models/counting/counting_arith/TimeArith.v"
    ],
    [
      "^time/",
      "models/time/"
    ],
    [
      "^stdlib/",
      "models/time/stdlib/"
    ],
    [
      "^examples/(HornerCount|StrassenCount)\\.v$",
      "models/counting/counting_arith/examples/\\1.v"
    ],
    [
      "^examples/eth/",
      "models/time/examples/eth/"
    ],
    [
      "^examples/(ETH\\w*\\.v)$",
      "models/time/examples/eth/\\1"
    ],
    [
      "^examples/",
      "models/time/examples/"
    ],
    [
      "^space/SpaceExamples\\.v$",
      "models/space/examples/SpaceExamples.v"
    ],
    [
      "^space/",
      "models/space/"
    ],
    [
      "^machine/MachineExamples\\.v$",
      "models/time/machine/examples/MachineExamples.v"
    ],
    [
      "^machine/",
      "models/time/machine/"
    ],
    [
      "^instances/",
      "models/time/instances/"
    ],
    [
      "^models/counting/TimeArith\\.v$",
      "models/counting/counting_arith/TimeArith.v"
    ],
    [
      "^models/counting/examples/",
      "models/counting/counting_arith/examples/"
    ]
  ],
  "definitions": {
    "bff/BFFComplexity.v": [
      "rec_cost",
      "step_bound"
    ],
    "bff/Type3Example.v": [
      "C_pot",
      "zero_pot",
      "V_cost",
      "W_cost",
      "C_maj",
      "V_maj",
      "W_maj"
    ]
  },
  "majorants": {
    "bff/BFFFeasibility.v": "Global Instance (\\w+)_hpoly\\b(?:(?!Global Instance).)*?Proof\\.\\s*refine \\(hpoly_intro _ _ \\(db <\\{ (.*?) \\}>\\)"
  },
  "sections": [
    [
      "Natural numbers, booleans, lists, binary integers, sums (models/time/stdlib)",
      "models/time/stdlib/"
    ],
    [
      "Basic feasible functionals (bff)",
      "bff/"
    ],
    [
      "Examples (models/time/examples)",
      "models/time/examples/"
    ],
    [
      "Counting operations (models/counting/counting_arith)",
      "models/counting/counting_arith/"
    ],
    [
      "Space: total allocation (models/space)",
      "models/space/"
    ],
    [
      "Environment machine for L: steps of the machine (models/time/machine)",
      "models/time/machine/"
    ]
  ],
  "notes": {
    "complexity_ext": "for f pointwise equal to g, from the bound cg of g",
    "horner_complexity": "when 1 <= c_fix, in the counting model of the file",
    "map_space": "when f allocates at most c",
    "models/time/stdlib/ListComplexity.v#fold_left_const_complexity": "when f costs at most c1 +> c2"
  },
  "names": {
    "Pos_add_mutual_complexity": "fun b => if b then Pos.add else Pos.add_carry",
    "complexity_tl": "tl",
    "dbl_complexity": "fix dbl (worker of double_length)",
    "length_acc_complexity": "length_acc (worker's bound in the context)",
    "length_acc_lifted_complexity": "length_acc (worker lifted to length_go)",
    "fold_left_hcomplexity": "fold_left"
  },
  "order": [
    "models/time/stdlib/NatComplexity.v",
    "models/time/stdlib/BoolComplexity.v",
    "models/time/stdlib/ListComplexity.v",
    "models/time/stdlib/HOListComplexity.v",
    "models/time/stdlib/PosComplexity.v",
    "models/time/stdlib/ZComplexity.v",
    "models/time/stdlib/SumComplexity.v",
    "bff/BFFComplexity.v",
    "bff/BFFFeasibility.v",
    "bff/Type3Example.v",
    "models/time/examples/Examples.v",
    "models/time/examples/BracketComparison.v",
    "models/counting/counting_arith/examples/HornerCount.v",
    "models/counting/counting_arith/examples/StrassenCount.v",
    "models/time/examples/eth/ETHCost.v",
    "models/space/examples/SpaceExamples.v",
    "models/time/machine/examples/MachineExamples.v"
  ],
  "groups": [
    "bff/BFFComplexity.v",
    "bff/BFFFeasibility.v",
    "bff/Type3Example.v"
  ],
  "table": {
    "runs": [
      "thunks",
      "env",
      "selfcase",
      "argenv",
      "envfix",
      "asm"
    ],
    "header": "bounds/header.md",
    "output": "bounds-comparison.md",
    "html": "bounds-comparison.html"
  }
}